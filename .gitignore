# Python
__pycache__/
*.py[cod]
*.pyd
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments and IDE
.venv/
venv/
env/
.idea/
.vscode/
*.code-workspace

# OS / secrets / local configuration
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
*.pem
*.key
secrets.toml
.streamlit/secrets.toml

# Notebook/runtime cache
.ipynb_checkpoints/
logs/
*.log
*.tmp
*.temp

# Dataset: keep only documentation/placeholders/manifests explicitly reviewed
data/raw/**
!data/raw/.gitkeep
data/external/real/**
!data/external/real/.gitkeep
data/manifests/**
!data/manifests/.gitkeep
data/**/*.zip
data/**/*.tar
data/**/*.gz
data/**/*.parquet
data/**/*.csv
data/**/*.json

# Models and generated artifacts
models/*.keras
models/*.h5
models/*.onnx
models/*.tflite
models/*.weights.*
artifacts/runs/**
!artifacts/runs/.gitkeep
artifacts/smoke/
artifacts/verification/
artifacts/final_evaluation_registry/
artifacts/report/**
!artifacts/report/.gitkeep

# Build/package
build/
dist/
*.egg-info/

# Reviewed, locked manifest evidence is portable and must reach GitHub/Colab.
# Raw archives/images and private real images remain ignored above.
!data/manifests/
!data/manifests/.gitkeep
!data/manifests/audit_manifest.csv
!data/manifests/data_audit.json
!data/manifests/pre_split_curation_v1/
!data/manifests/pre_split_curation_v1/*.csv
!data/manifests/pre_split_curation_v1/*.json
!data/manifests/split_v1/
!data/manifests/split_v1/*.csv
!data/manifests/split_v1/*.json
